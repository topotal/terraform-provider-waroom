# Environment for acceptance (E2E) tests.
#
# Copy this file to .env.e2e (gitignored) and fill in the values for the Waroom you test against.
# It is loaded with the 1Password CLI, so each value may be either:
#   - an op:// secret reference, resolved at run time:  E2E_WAROOM_API_KEY=op://<vault>/<item>/<field>
#   - a plain value (e.g. for a local Waroom):           E2E_WAROOM_API_KEY=<local-api-key>
#
# Usage: task test:acc:op   (= op run --env-file .env.e2e -- task test:acc)

# Waroom API host, without the /api/v0 suffix (the client adds it).
E2E_WAROOM_API_ENDPOINT=https://api.staging.waroom.com
E2E_WAROOM_API_KEY=op://<vault>/<item>/<field>

# Existing Waroom service used by acceptance tests for service-scoped resources
# (there is no API to create a service).
E2E_WAROOM_SERVICE_NAME=

# Optional: the sub of an existing user with a verified phone number (only such users can join an
# on-call rotation). When unset, the waroom_on_call_team test runs without participants.
E2E_WAROOM_ON_CALL_USER_SUB=
