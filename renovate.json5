{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^github\\.com/hashicorp/terraform-plugin-/"],
      "groupName": "hashicorp terraform-plugin"
    }
  ]
}
