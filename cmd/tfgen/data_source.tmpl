// Read refreshes Terraform state with the latest data.
func (d *{{.Pascal}}DataSource) Read(ctx context.Context, req datasource.ReadRequest, resp *datasource.ReadResponse) {
	// Read Terraform configuration data into the model
	var data {{.Pascal}}DataSourceModel
	resp.Diagnostics.Append(req.Config.Get(ctx, &data)...)
	if resp.Diagnostics.HasError() {
		return
	}

	// TODO: look up the object with d.client and copy it into data.
	// Unlike a resource, a data source must not drop a missing object silently:
	// on 404 (or no match in a List response) report it with resp.Diagnostics.AddError.

	tflog.Info(ctx, "read {{.Snake}} data source")

	// Save data into Terraform state
	resp.Diagnostics.Append(resp.State.Set(ctx, &data)...)
}
